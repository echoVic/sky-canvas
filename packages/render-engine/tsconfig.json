{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "types": ["@webgpu/types", "node"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "removeComments": false,
    "sourceMap": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/animation/**",
    "src/effects/**",
    "src/physics/**",
    "src/particles/**",
    "src/plugins/**",
    "src/editor/**",
    "src/debug/**",
    "src/benchmark/**",
    "src/text/**",
    "src/paths/**",
    "src/performance/**",
    "src/interface/**"
  ]
}
